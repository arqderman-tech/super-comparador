# =======================================================
# SuperComparador - .gitignore
# Restricciones de tamaño de GitHub (máx 100MB por archivo)
# =======================================================

# Archivos de exportación grandes generados por scrapers locales
lagallega_products.json
lagallega_products.csv
coto_promos.json
promos_carrefour.json

# Salidas de scrapers y datos temporales pesados en la raíz
/output_carrefour/
/data/

# Base de datos completa / backups locales pesados
database_full.db
*.db-journal
*.db-wal
*.db-shm
*.db.tmp
*.bak*

# Python y entornos virtuales
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
dist/
*.egg-info/

# Logs de scrapers
*.log

# Editores y entornos
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Conflictos y sincronización de OneDrive
*-Administrator.*
*-Administrador.*
*-DESKTOP-*
*.tmp
~$*
.DS_Store
Thumbs.db
desktop.ini
